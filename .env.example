# Used by ./deploy.sh to deploy the AWS backend (services/aws).

# Shared secret the web app and devices send in the x-internal header.
# Generate one with: openssl rand -hex 32
INTERNAL_SECRET=

# From your Spotify developer app (https://developer.spotify.com/dashboard).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Telegram notifications for sign-ups, taps on new cards, etc.
# Leave both empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
