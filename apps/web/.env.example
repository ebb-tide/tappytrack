# Copy to apps/web/.env.local for local development.

# From your Spotify developer app. Add <NEXTAUTH_URL>/api/auth/callback/spotify
# as a redirect URI in the Spotify dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# NextAuth settings. Generate the secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# The deployed backend: the API Gateway invoke URL (ending in /Prod) and the
# same value as INTERNAL_SECRET in the root .env.
LAMBDA_URL=
LAMBDA_SECRET=
