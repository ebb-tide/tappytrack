# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
apps/web/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/*
/out/
/apps/web/.next/
/apps/web/out/

# production
/build
/apps/web/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the .example templates are committed)
.env*
apps/web/.env*
!.env.example

# vercel
.vercel

# local tooling
.claude

# typescript
*.tsbuildinfo
next-env.d.ts

.aws-sam/
services/aws/.aws-sam/
services/aws/lambdas/*/node_modules/*
archive/*
devices/pi-pico/*.json
!devices/pi-pico/device.example.json
